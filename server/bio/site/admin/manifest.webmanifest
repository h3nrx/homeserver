{
  "name": "__BRAND__ admin",
  "short_name": "__BRAND__",
  "description": "Admin panel for the __BRAND__ home server",
  "id": "/admin/",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#06080f",
  "theme_color": "#06080f",
  "icons": [
    { "src": "../img/__ICON__-logo-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../img/__ICON__-app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "../img/__ICON__-app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Minecraft", "url": "/admin/#minecraft", "icons": [{ "src": "../img/__ICON__-app-192.png", "sizes": "192x192" }] },
    { "name": "Files", "url": "/admin/#files", "icons": [{ "src": "../img/__ICON__-app-192.png", "sizes": "192x192" }] },
    { "name": "Music Radio", "url": "/admin/#music", "icons": [{ "src": "../img/__ICON__-app-192.png", "sizes": "192x192" }] }
  ]
}
